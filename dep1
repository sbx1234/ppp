//BD
CREATE DATABASE bddepartamentos;
USE bddepartamentos;

-- Tabla departamentos (el "1")
CREATE TABLE departamentos (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL UNIQUE
);

-- Tabla empleados (los "muchos")
CREATE TABLE empleados (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL,
  cargo VARCHAR(100) NOT NULL,
  id_departamento INT NOT NULL,
  FOREIGN KEY (id_departamento) REFERENCES departamentos(id)
);



//conexion.php
<?php
class Conexion {
    private $servername = "localhost";
    private $username   = "root";
    private $password   = "";
    private $database   = "bddepartamentos";
    public  $conn;

    public function __construct() {
        $this->conn = new mysqli(
            $this->servername,
            $this->username,
            $this->password,
            $this->database
        );

        if ($this->conn->connect_error) {
            die(json_encode(["error" => "No se conectó a la base: " . $this->conn->connect_error]));
        }
    }
}
?>


//departamento.php
<?php
require_once "conexion.php";

class Departamento {

    private $conn;

    public function __construct() {
        $db = new Conexion();
        $this->conn = $db->conn;
    }

    // -------------------------------------------------
    // Registrar un departamento
    // -------------------------------------------------
    public function guardarDepartamento($nombre) {

        if (trim($nombre) == "") {
            return ["error" => "El nombre del departamento está vacío"];
        }

        $stmt = $this->conn->prepare("INSERT INTO departamentos (nombre) VALUES (?)");
        $stmt->bind_param("s", $nombre);

        if ($stmt->execute()) {
            return ["success" => "Departamento registrado"];
        } else {
            return ["error" => "No se guardó: " . $this->conn->error];
        }
    }

    // -------------------------------------------------
    // Listar todos los departamentos (para los <select>)
    // -------------------------------------------------
    public function listarDepartamentos() {
        $res = $this->conn->query("SELECT * FROM departamentos ORDER BY nombre");
        $resultado = [];
        while ($fila = $res->fetch_assoc()) {
            $resultado[] = $fila;
        }
        return $resultado;
    }

    // -------------------------------------------------
    // Ingresar un empleado asociado a un departamento
    // -------------------------------------------------
    public function guardarEmpleado($nombre, $cargo, $idDepartamento) {

        if (trim($nombre) == "" || trim($cargo) == "") {
            return ["error" => "Nombre y cargo son obligatorios"];
        }

        // Verificar que el departamento exista
        $stmt = $this->conn->prepare("SELECT id FROM departamentos WHERE id = ?");
        $stmt->bind_param("i", $idDepartamento);
        $stmt->execute();
        $res = $stmt->get_result();

        if ($res->num_rows == 0) {
            return ["error" => "El departamento no existe"];
        }

        $stmt = $this->conn->prepare(
            "INSERT INTO empleados (nombre, cargo, id_departamento) VALUES (?, ?, ?)"
        );
        $stmt->bind_param("ssi", $nombre, $cargo, $idDepartamento);

        if ($stmt->execute()) {
            return ["success" => "Empleado registrado"];
        } else {
            return ["error" => "No se guardó: " . $this->conn->error];
        }
    }

    // -------------------------------------------------
    // Buscar TODOS los empleados de un departamento
    // -------------------------------------------------
    public function buscarEmpleadosPorDepartamento($idDepartamento) {

        $stmt = $this->conn->prepare(
            "SELECT e.id, e.nombre, e.cargo, d.nombre AS departamento
             FROM empleados e
             INNER JOIN departamentos d ON e.id_departamento = d.id
             WHERE d.id = ?"
        );
        $stmt->bind_param("i", $idDepartamento);
        $stmt->execute();
        $res = $stmt->get_result();

        $resultado = [];
        while ($fila = $res->fetch_assoc()) {
            $resultado[] = $fila;
        }

        return $resultado;
    }
}
?>



